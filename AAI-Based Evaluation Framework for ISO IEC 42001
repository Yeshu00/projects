import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import LabelEncoder, StandardScaler
from fairlearn.metrics import (
    MetricFrame,
    selection_rate,
    demographic_parity_difference,
    demographic_parity_ratio,
    equalized_odds_difference
)

# --- User Inputs ---
dataset_filename = input("Enter dataset filename (e.g., bank-full.csv): ").strip()
csv_separator = input("Enter CSV separator (e.g., , or ;): ").strip()
target_variable = input("Enter target variable column name: ").strip()
favorable_class = input("Enter favorable class (e.g., 'yes' or '1'): ").strip()
protected_attribute = input("Enter protected attribute column name (e.g., 'age' or 'gender'): ").strip()

# --- Load dataset ---
df = pd.read_csv(dataset_filename, sep=csv_separator)
print(f" Dataset loaded with {df.shape[0]} rows and {df.shape[1]} columns.")

# --- Encode target variable to 0/1 if needed ---
if df[target_variable].dtype == 'object':
    le = LabelEncoder()
    df[target_variable] = le.fit_transform(df[target_variable])
    print(f" Target variable '{target_variable}' encoded to 0/1.")

# --- Create protected group dynamically ---
if df[protected_attribute].dtype in ['int64', 'float64']:
    threshold = df[protected_attribute].median()
    df["protected_group"] = np.where(df[protected_attribute] < threshold, "unprivileged", "privileged")
else:
    df["protected_group"] = df[protected_attribute].astype("category")

# --- Show protected group distribution ---
print("\n Protected group distribution:")
print(df.groupby("protected_group")[target_variable].agg(['count', 'sum']))

# --- Train Logistic Regression if prediction column doesn't exist ---
if "prediction" not in df.columns:
    print("\n⚙️ No 'prediction' column found. Training a Logistic Regression model...")

    X = pd.get_dummies(df.drop(columns=[target_variable]), drop_first=True)
    y = df[target_variable]

    # Scale numeric features
    num_cols = X.select_dtypes(include=['int64', 'float64']).columns
    scaler = StandardScaler()
    X[num_cols] = scaler.fit_transform(X[num_cols])

    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

    max_iter_dynamic = max(100, int(df.shape[0]/10))
    model = LogisticRegression(max_iter=max_iter_dynamic, solver="saga")
    model.fit(X_train, y_train)

    df["prediction"] = model.predict(X)
    print(" Logistic Regression trained and predictions added to dataframe.")

# --- Use Fairlearn to compute fairness metrics ---
y_true = df[target_variable]
y_pred = df["prediction"]
protected = df["protected_group"]

# Create MetricFrame
mf = MetricFrame(
    metrics={"selection_rate": selection_rate},
    y_true=y_true,
    y_pred=y_pred,
    sensitive_features=protected
)

print("\n Fairness metrics (Fairlearn):")
print("Selection rate by group:\n", mf.by_group)

print("Demographic Parity Difference:", demographic_parity_difference(y_true, y_pred, sensitive_features=protected))
print("Demographic Parity Ratio:", demographic_parity_ratio(y_true, y_pred, sensitive_features=protected))
print("Equalized Odds Difference:", equalized_odds_difference(y_true, y_pred, sensitive_features=protected))
import json

# --- Compute Fairlearn metrics ---
dpd = demographic_parity_difference(y_true, y_pred, sensitive_features=protected)
dpr = demographic_parity_ratio(y_true, y_pred, sensitive_features=protected)
eod = equalized_odds_difference(y_true, y_pred, sensitive_features=protected)

# --- Thresholds for deciding "no bias" ---
di_threshold = 0.1   # ±10% around 1
spd_threshold = 0.05 # ±5% around 0
eod_threshold = 0.05 # ±5% around 0

# --- Check bias conditions ---
if abs(dpr - 1) <= di_threshold and abs(dpd) <= spd_threshold and abs(eod) <= eod_threshold:
    conclusion = " Dataset shows no significant bias based on the selected protected attribute."
else:
    conclusion = " Dataset shows potential bias based on the selected protected attribute."

# --- Build JSON report ---
fairness_report = {
    "status": "Analysis Complete",
    "fairness": {
        "demographic_parity_difference": round(dpd, 4),
        "demographic_parity_ratio": round(dpr, 4),
        "equalized_odds_difference": round(eod, 4),
    },
    "explain": {
        "selection_rate_by_group": mf.by_group["selection_rate"].to_dict()
    },
    "conclusion": conclusion
}

print("\n Final JSON Fairness Report:")
print(json.dumps(fairness_report, indent=4))
