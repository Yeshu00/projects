import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import LabelEncoder, StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
import shap
import json

dataset_filename = input("Enter dataset filename (e.g., bank-full.csv): ").strip()
csv_separator = ';'
target_variable = input("Enter the target variable column name: ").strip()
favorable_class = input("Enter the favorable class (e.g., 'yes' or '1'): ").strip()


try:
    df = pd.read_csv(dataset_filename, sep=csv_separator)
    print(f"Dataset '{dataset_filename}' loaded successfully with {df.shape[0]} rows.")
except FileNotFoundError:
    print(f"Error: Dataset '{dataset_filename}' not found. Please ensure the file is uploaded.")
    # Exit or handle the error as needed
    exit()


# --- Separate target variable ---
if target_variable not in df.columns:
    print(f"Error: Target variable '{target_variable}' not found in the dataset.")
    exit() # Simple exit for demonstration

y = df[target_variable]
X = df.drop(columns=[target_variable])

# --- Identify column types ---
# Assuming object or category dtypes are categorical, others are numerical (adjust if needed)
categorical_features = X.select_dtypes(include=['object', 'category']).columns
numerical_features = X.select_dtypes(include=np.number).columns

print(f"\nIdentified {len(categorical_features)} categorical features and {len(numerical_features)} numerical features.")


# --- Preprocessing Pipeline ---
# Create transformers for numerical and categorical features
numerical_transformer = StandardScaler()
categorical_transformer = OneHotEncoder(handle_unknown='ignore', drop='first') # Use drop='first' to avoid multicollinearity

# Create a column transformer to apply different transformations to different columns
preprocessor = ColumnTransformer(
    transformers=[
        ('num', numerical_transformer, numerical_features),
        ('cat', categorical_transformer, categorical_features)
    ],
    remainder='passthrough' # Keep other columns (if any) - though typically all should be num or cat
)

# --- Create a pipeline including preprocessing and model training ---
# Encode the target variable if it's an object type
if y.dtype == 'object':
    le = LabelEncoder()
    y = le.fit_transform(y)
    print("\nTarget variable encoded successfully.")

# Split data AFTER separating X and y, but BEFORE preprocessing X
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# Create the full pipeline
model_pipeline = Pipeline(steps=[('preprocessor', preprocessor),
                                 ('classifier', LogisticRegression(max_iter=1000)) # Increased max_iter
                                ])

# --- Train the model ---
print("\nTraining the Logistic Regression model...")
model_pipeline.fit(X_train, y_train)
print("Model trained successfully.")

# Get the trained classifier model from the pipeline
trained_model = model_pipeline.named_steps['classifier']
# Get the preprocessed feature names
preprocessed_feature_names = model_pipeline.named_steps['preprocessor'].get_feature_names_out()


# --- Automatically create feature_to_original_map ---
# This requires parsing the names generated by OneHotEncoder
feature_to_original_map = {}

# Get the names generated by the preprocessor step
preprocessed_feature_names_list = list(preprocessed_feature_names)

# Get the transformers and their corresponding original columns from the preprocessor
transformers = preprocessor.transformers_

# Rebuild mapping based on get_feature_names_out() and original transformer columns
feature_to_original_map = {}
feature_names_out = preprocessor.get_feature_names_out()

for i, feature_name_out in enumerate(feature_names_out):
    # Split the name generated by ColumnTransformer (e.g., 'num__age', 'cat__job_blue-collar')
    if '__' in feature_name_out:
        transformer_name, feature_part = feature_name_out.split('__', 1)

        if transformer_name == 'num':
            # For numerical features, the feature_part is the original column name
            feature_to_original_map[feature_name_out] = feature_part
        elif transformer_name == 'cat':
            # For categorical features, the feature_part is like 'original_column_category_value'
            # We need to find the original column name.
            # Iterate through original categorical columns to find a match at the beginning of feature_part
            found_original_cat = False
            for original_cat_col in categorical_features:
                # Check if the feature_part starts with the original categorical column name + underscore
                # (since categories are appended with underscore)
                if feature_part.startswith(f'{original_cat_col}_'):
                     feature_to_original_map[feature_name_out] = original_cat_col
                     found_original_cat = True
                     break
            if not found_original_cat:
                 # Fallback if parsing fails - use the feature part as original attribute
                 feature_to_original_map[feature_name_out] = feature_part

        else:
            # Handle columns passed through without a transformer prefix (if remainder='passthrough')
            feature_to_original_map[feature_name_out] = feature_name_out
    else:
         # This case might happen if remainder='passthrough' includes columns without '__' prefix
         feature_to_original_map[feature_name_out] = feature_name_out


# print(feature_to_original_map) # Uncomment to see the mapping


# --- Calculate SHAP values ---
# Initialize SHAP explainer with the trained model and scaled training data as the background
# Use the preprocessor to transform X_train to get X_train_scaled for the explainer background
X_train_scaled_for_shap = model_pipeline.named_steps['preprocessor'].transform(X_train)
explainer = shap.LinearExplainer(trained_model, X_train_scaled_for_shap)

# Use the preprocessor to transform X_test to get X_test_scaled for SHAP value calculation
X_test_scaled_for_shap = model_pipeline.named_steps['preprocessor'].transform(X_test)
shap_values = explainer.shap_values(X_test_scaled_for_shap)

# For binary classification, shap_values is a list of arrays [shap_values_for_class_0, shap_values_for_class_1]
# We typically use the SHAP values for the positive class (class 1, encoded as 1) for overall importance
if isinstance(shap_values, list):
    shap_values = shap_values[1] # Use SHAP values for the positive class


# --- Aggregate SHAP influence by original attribute ---
# Calculate mean absolute SHAP value for each preprocessed feature
mean_abs_shap_values = np.mean(np.abs(shap_values), axis=0)

# Create a pandas Series to associate mean absolute SHAP values with preprocessed feature names
preprocessed_feature_shap_importance = pd.Series(mean_abs_shap_values, index=preprocessed_feature_names)

# Aggregate SHAP influence by original attribute
original_attribute_shap_influence = {}

for preprocessed_name, shap_importance in preprocessed_feature_shap_importance.items():
    original_attribute = feature_to_original_map.get(preprocessed_name, preprocessed_name) # Get original attribute name

    # Sum the mean absolute SHAP values for all features belonging to that original attribute.
    if original_attribute not in original_attribute_shap_influence:
        original_attribute_shap_influence[original_attribute] = 0

    original_attribute_shap_influence[original_attribute] += shap_importance # Sum mean absolute SHAP values


# Sort original attributes by aggregated SHAP influence
sorted_original_attribute_shap_influence = dict(sorted(original_attribute_shap_influence.items(), key=lambda item: item[1], reverse=True))
rounded_shap_influence = {k: round(v, 2) for k, v in sorted_original_attribute_shap_influence.items()}
report = {
    "status": "Explainability Analysis Complete", # Set the requested status
    "explain": {
        "top_features":rounded_shap_influence # Use the aggregated SHAP influence
    }
}

# Convert the dictionary to a JSON string
report_json_string = json.dumps(report, indent=4)

# Print the JSON string
print(report_json_string)

